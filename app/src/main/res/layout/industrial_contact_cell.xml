<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:minHeight="48dp"
    android:background="@color/industrial_panel" android:padding="6dp">
    <ImageView android:id="@+id/contact_image" android:layout_width="match_parent"
        android:layout_height="128dp" android:scaleType="centerInside"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/contact_caption" style="@style/IndustrialReadout"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:importantForAccessibility="no" />
</LinearLayout>
