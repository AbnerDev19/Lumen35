<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_enabled="false"><shape android:shape="rectangle"><solid android:color="@color/industrial_matte"/><corners android:radius="@dimen/industrial_radius"/><stroke android:width="1dp" android:color="@color/industrial_line"/></shape></item>
  <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="@color/industrial_pressed"/><corners android:radius="@dimen/industrial_radius"/><stroke android:width="1dp" android:color="@color/industrial_orange"/></shape></item>
  <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="@color/industrial_panel"/><corners android:radius="@dimen/industrial_radius"/><stroke android:width="2dp" android:color="@color/industrial_orange"/></shape></item>
  <item android:state_selected="true"><shape android:shape="rectangle"><solid android:color="@color/industrial_panel"/><corners android:radius="@dimen/industrial_radius"/><stroke android:width="2dp" android:color="@color/industrial_orange"/></shape></item>
  <item><shape android:shape="rectangle"><solid android:color="@color/industrial_panel"/><corners android:radius="@dimen/industrial_radius"/><stroke android:width="1dp" android:color="@color/industrial_line"/></shape></item>
</selector>
